<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Task31.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Task31.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Task31">
    <StackPanel Margin="10">
        <TextBlock Text="Додати нове місто:" FontWeight="Bold" Margin="0,0,0,10"/>
        <TextBox Name="CityName" Watermark="Назва міста" Margin="0,0,0,5"/>
        <TextBox Name="CityArea" Watermark="Площа (км²)" Margin="0,0,0,5"/>
        <TextBox Name="CityPopulation" Watermark="Населення" Margin="0,0,0,10"/>
        <Button Content="Додати" Click="AddCity_Click" Width="100" HorizontalAlignment="Left" Margin="0,0,0,10"/>
        <TextBlock Text="Список міст:" FontWeight="Bold" Margin="0,10,0,5"/>
        <TextBox x:Name="CityListBox" Height="300" Foreground="White"/>
    </StackPanel>
</Window>
