<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="lab7.MainWindow"
        Title="lab_7._2">
    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="Додати товар:" FontWeight="Bold"/>
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,10">
            <TextBlock Text="Назва:" Grid.Row="0" Grid.Column="0" Margin="0,0,10,0"/>
            <TextBox x:Name="textBox1" Grid.Row="0" Grid.Column="1"/>
            
            <TextBlock Text="Тип:" Grid.Row="1" Grid.Column="0" Margin="0,0,10,0"/>
            <TextBox x:Name="textBox2" Grid.Row="1" Grid.Column="1"/>
            
            <TextBlock Text="Кількість:" Grid.Row="2" Grid.Column="0" Margin="0,0,10,0"/>
            <TextBox x:Name="textBox3" Grid.Row="2" Grid.Column="1"/>
            
            <TextBlock Text="Ціна:" Grid.Row="3" Grid.Column="0" Margin="0,0,10,0"/>
            <TextBox x:Name="textBox4" Grid.Row="3" Grid.Column="1"/>
        </Grid>
        
        <TextBlock x:Name="errorText" Foreground="Red" Margin="0,5"/>
        <Button x:Name="button1" Content="Додати" HorizontalAlignment="Left" Click="Button1_Click"/>
        
        <ListBox x:Name="listBox1" Height="150" Margin="0,20"/>
        
        <Button x:Name="button2" Content="Сортувати за назвою" HorizontalAlignment="Left" Margin="0,10" Click="Button2_Click"/>
        
        <TextBlock Text="Пошук товару:" FontWeight="Bold" Margin="0,20,0,0"/>
        <TextBox x:Name="textBox5" Width="200" HorizontalAlignment="Left"/>
        <Button x:Name="button3" Content="Знайти" HorizontalAlignment="Left" Click="Button3_Click"/>
        
        <TextBlock x:Name="label1" Margin="0,10"/>
    </StackPanel>
</Window>