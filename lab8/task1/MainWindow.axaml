<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="lab8.MainWindow"
        Title="Product Manager">
        
    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="Додати продукт" FontSize="16" FontWeight="Bold"/>
        
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Назва:" Width="100"/>
            <TextBox x:Name="textBox1" Width="200"/>
        </StackPanel>
        
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Ціна:" Width="100"/>
            <NumericUpDown x:Name="numericUpDown1" Width="200" Minimum="0"/>
        </StackPanel>
        
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Категорія:" Width="100"/>
            <TextBox x:Name="textBox2" Width="200"/>
        </StackPanel>
        
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="В наявності:" Width="100"/>
            <CheckBox x:Name="checkBox1" Content="Так"/>
        </StackPanel>
        
        <Button Content="Додати продукт" Click="AddProduct_Click" Margin="0,10,0,0"/>
        <Button Content="Показати всі продукти" Click="ShowAllProducts_Click"/>
        <Button Content="Показати статистику" Click="ShowStats_Click"/>
        
        <ListBox x:Name="listBox1" Height="200" Margin="0,10,0,0"/>
    </StackPanel>
</Window>