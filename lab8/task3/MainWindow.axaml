<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
        x:Class="lab8.MainWindow"
        Title="Місяці та аксесуари"
        Width="400" Height="300">
    <StackPanel x:Name="MainPanel" Margin="20" Spacing="10">
        <TextBlock Text="Введіть номер місяця (1-12):"/>
        <TextBox x:Name="MonthTextBox"/>
        <Button x:Name="ShowButton" Content="Показати" Click="OnShowButtonClick"/>
        <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="0,10"/>
        
        <StackPanel x:Name="DialogPanel" Spacing="10" HorizontalAlignment="Center">
            <TextBlock Text="Хочете ввести інший місяць?"/>
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <Button x:Name="ContinueButton" Content="Так" Click="OnContinueButtonClick"/>
                <Button x:Name="ExitButton" Content="Ні" Click="OnExitButtonClick"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>