<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="lab13.MainWindow"
        Title="Перевірка сервера">
        <StackPanel Margin="10">
            <Button Content="Почати перевірку" Click="StartButton_Click" Margin="0,0,0,10" />
            <Button Content="Зупинити перевірку" Click="StopButton_Click" Margin="0,0,0,10"/>
            <ListBox x:Name="MessageListBox" Height="200"/>
        </StackPanel>
</Window>