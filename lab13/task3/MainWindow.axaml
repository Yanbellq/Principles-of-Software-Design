<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="lab13.MainWindow"
        Title="Імітація роботи з БД">
    <StackPanel Margin="10">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button x:Name="StartButton" Content="Почати роботу з БД" 
                    Click="StartButton_Click" Width="180" Margin="0,0,10,0"/>
            <Button x:Name="StopButton" Content="Зупинити" 
                    Click="StopButton_Click" Width="100" IsEnabled="False"/>
        </StackPanel>
        <ListBox x:Name="MessageListBox" Height="350"/>
    </StackPanel>
</Window>