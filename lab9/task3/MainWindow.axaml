<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
        x:Class="lab9.MainWindow"
        Title="Перевірка балансу дужок" Width="600" Height="400">
    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="Перевірка балансу круглих дужок у математичному виразі"
                   FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
        
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBox x:Name="txtFilePath" Width="400" IsReadOnly="True"/>
            <Button Content="Вибрати файл" Click="BrowseFile_Click"/>
        </StackPanel>
        
        <TextBlock x:Name="txtResult" FontSize="14" FontWeight="Bold"/>
        <TextBlock x:Name="txtPairs" FontSize="12" TextWrapping="Wrap"/>
    </StackPanel>
</Window>