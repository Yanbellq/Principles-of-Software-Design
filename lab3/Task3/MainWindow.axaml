<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Task3.MainWindow"
        Title="Text Replacement App">
    <Grid>
    <Image Source="avares://Task3/Assets/back.jpeg" Stretch="UniformToFill" />
        <StackPanel Margin="20" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#80000000">
            <TextBlock Text="Введіть текст:"/>
            <TextBox Name="InputTextBox" AcceptsReturn="True" Height="100" Width="600" />
            
            <TextBlock Text="Слово для заміни:" Margin="0,10,0,0"/>
            <TextBox Name="WordToReplaceTextBox" Width="600" Height="50" />
            
            <TextBlock Text="Нове слово:" Margin="0,10,0,0"/>
            <TextBox Name="NewWordTextBox" Width="600" Height="50" />
            
            <Button Content="Замінити" Margin="0,10,0,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnReplaceButtonClick" Width="600" Height="35" />
            
            <TextBlock Text="Результат:" Margin="0,10,0,0"/>
            <TextBox Name="ResultTextBox" AcceptsReturn="True" Height="100" IsReadOnly="True" Width="600"/>
        </StackPanel>
    </Grid>
</Window>
