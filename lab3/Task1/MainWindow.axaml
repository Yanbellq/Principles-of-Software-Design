<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Task1.MainWindow"
        Title="Change Case"
        Width="400" Height="200">
        
    <Grid>
    <Image Source="avares://Task1/Assets/back.jpeg" Stretch="UniformToFill" />
        <StackPanel Margin="20" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#80000000">
            <TextBox Name="InputTextBox" Width="360" Height="30" Margin="0,0,0,10" />
            <Button Name="ChangeCaseButton" Width="360" Height="30" Content="Змінити регістр" Click="OnChangeCaseButtonClick" />
            <TextBlock Name="ResultTextBlock" Width="360" Height="30" Margin="0,10,0,0" />
        </StackPanel>
    </Grid>
</Window>
